{
  "name": "discord-desktop",
  "version": "0.1.0",
  "description": "Aplicativo desktop de comunicação para amigos (Windows 10/11 x64)",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/build-desktop.mjs",
    "build:web": "tsc && vite build",
    "desktop": "npm run build && node scripts/start-desktop.mjs",
    "test:desktop": "npm run build && node scripts/smoke-desktop.mjs",
    "release": "npm run build && node scripts/build-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "deploy:pages": "node scripts/deploy-gh-pages.mjs"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "webrtc",
    "voice",
    "chat"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "mqtt": "^5.16.1",
    "peerjs": "^1.5.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "esbuild": "0.25.12",
    "happy-dom": "21.0.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
